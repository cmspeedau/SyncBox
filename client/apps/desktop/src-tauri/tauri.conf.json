{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syncbox",
  "version": "0.1.0",
  "identifier": "app.syncbox.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Syncbox",
        "width": 420,
        "height": 600,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "publisher": "Syncbox contributors",
    "copyright": "Copyright © 2026 CMSpeedAU",
    "license": "MIT",
    "homepage": "https://github.com/cmspeedau/SyncBox",
    "category": "Utility",
    "shortDescription": "File sync, with an encrypted vault as a choice",
    "longDescription": "Syncbox keeps a folder — or a mounted vault — in sync with a Syncbox server. A vault is encrypted on the device before anything leaves it; a sync space is not, and is stored on the server in the clear.",
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
