{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syncbox",
  "version": "0.1.0",
  "identifier": "app.syncbox.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Syncbox",
        "width": 480,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
