# Copy to .env beside docker-compose.yml (or the repo root, wherever you run
# compose from) and fill in the secrets. Compose deliberately refuses to start
# rather than bringing up a server with a generated credential that vanishes on
# the next restart — so generate real ones:
#
#   openssl rand -hex 32
#
# This file holds secrets; it is gitignored, as is everything named .env*.

# The one account credential. Clients exchange it for bearer tokens
# (POST /api/v1/auth/token). Long and random, not a phrase.
SYNCBOX_PASSWORD=

# Signs bearer tokens across restarts. Unset means each boot signs with a
# fresh key and every client silently logs out on restart.
SYNCBOX_TOKEN_SECRET=

# How often the server snapshots itself. Anything under 1m is refused.
SYNCBOX_BACKUP_SCHEDULE=1h

# Only needed for the tls profile (docker compose --profile tls): the domain
# Caddy asks Let's Encrypt for a certificate for.
SYNCBOX_DOMAIN=

# Object storage as a snapshot target instead of /backups, if wanted —
# uncomment together; see docs/backup.md. The bucket needs object lock
# enabled at creation; every sealed snapshot then sits under COMPLIANCE
# retention the service itself enforces.
# SYNCBOX_BACKUP_TARGET=s3://my-bucket/syncbox
# SYNCBOX_S3_ENDPOINT=https://minio.example.internal   # omit for AWS
# SYNCBOX_S3_ACCESS_KEY=
# SYNCBOX_S3_SECRET_KEY=

# A command run after every sealed snapshot — restic/rsync/borg carry it
# further offsite. The snapshot name and path arrive in the environment.
# SYNCBOX_BACKUP_POST=

# Requests per second per caller IP once sustained; off on a LAN, set it if
# this box faces the internet (and still put TLS in front).
# SYNCBOX_RATE_LIMIT=50

# Refuse commits to a vault the registry does not know. Leave it off while any
# client still uses a hand-invented vault id; set it to 1 after every client has
# been pointed at a vault created in the console.
# SYNCBOX_REQUIRE_REGISTERED_VAULTS=1
