# Copy to the repository root as .env and fill in real values.
#
#   SYNCBOX_PASSWORD      the one account credential clients log in with
#   SYNCBOX_TOKEN_SECRET  signs bearer tokens; keep it stable or tokens die on restart
#
# Generate either with:
#   openssl rand -hex 32

SYNCBOX_PASSWORD=replace-me
SYNCBOX_TOKEN_SECRET=replace-me

# Optional.
SYNCBOX_BACKUP_SCHEDULE=1h

# Only needed with the tls profile.
SYNCBOX_DOMAIN=sync.example.com
